# ============================================================
# JARVIS Dashboard · environment template
#
# Copy to .env and fill in real values. Do NOT commit .env.
#
# After editing, run:    npm install && npm start
# Then open:             http://localhost:8765/index.html
# ============================================================

# --- MiniMax (the LLM the chat widget talks to) -----------------------
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.MiniMax.com/v1
MINIMAX_MODEL=MiniMax-M2

# --- Google OAuth (from Google Cloud Console) -------------------------
# 1. Create an OAuth client of type "Web application".
# 2. Add the URI below as an authorized redirect URI
#    (it must match GOOGLE_REDIRECT_URI exactly).
# 3. Enable the Calendar API and Gmail API for the project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8765/oauth/callback

# --- Server ----------------------------------------------------------
PORT=8765

# --- Token storage ----------------------------------------------------
# This file is written as PLAINTEXT on disk and contains your Google
# access + refresh tokens. Set restrictive permissions (chmod 600) and
# keep it out of version control. .gitignore should already cover it.
TOKEN_STORE_PATH=./tokens.json

# --- Tool-call loop guard --------------------------------------------
# Caps the number of LLM round-trips per /api/chat request so a runaway
# tool loop can't burn your request budget.
TOOL_MAX_ITERATIONS=10