{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JARVIS Dashboard",
  "version": "0.1.0",
  "identifier": "local.jarvis.dashboard",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://jarviss-mac-mini.taile919c2.ts.net:8765/index.html",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "JARVIS Dashboard",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "url": "http://jarviss-mac-mini.taile919c2.ts.net:8765/index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "JARVIS HUD dashboard",
    "longDescription": "Tauri 2.x shell wrapping the live JARVIS dashboard served on the local network."
  }
}